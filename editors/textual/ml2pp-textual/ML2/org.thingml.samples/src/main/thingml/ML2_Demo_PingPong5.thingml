datatype String<256>
	@type_checker `String`
	@c_type `char *`
	@java_type `String`
	@js_type `String`
datatype Boolean<1>
	@type_checker `Boolean`
	@c_type `uint8_t`
	@java_type `boolean`
	@js_type `boolean`
datatype Int32<4>
	@type_checker `Integer`
	@c_type `int32_t`
	@java_type `int`
	@js_type `int`

datatype Float64<8>
	@type_checker `Float64`
	@c_type `double`
	@java_type `double`
	@js_type `number`

// Messages for IoT Solar Energy Use Case (aggregated) 
thing fragment EnergyMsgs {
	message sensor_data(use_kw : Float64)
	message ack()
	message query(use_kw : Float64)
	message alert()
	message safe()
}

// SensorClient: Sends site-level aggregated DC power every 15 minutes
thing SensorClient includes EnergyMsgs {
	required port data_service {
		sends sensor_data receives ack
	}
	property my_use : Float64 = 0.0

	statechart SensorClientBehavior init Wait {
		state Wait {
			on entry do
				print "Waiting 15 minutes before sending aggregated data...\n"
			end
			transition -> SendData
			timeout 00:15:00
		}
		state SendData {
			on entry do
				print "Sending aggregated DC power to server...\n"
				data_service!sensor_data(my_use)
			end
			transition -> ReceiveAck
			event data_service?ack
		}
		state ReceiveAck {
			on entry print "Aggregated data acknowledged by server.\n"
			transition -> Wait
		}
	}
}

// EnergyServer: Forwards aggregated data to analytics and returns safe/alert
thing EnergyServer includes EnergyMsgs {
	provided port data_service {
		sends ack receives sensor_data
	}
	required port fa_service {
		sends query receives alert receives safe
	}
	property use_kw : Float64

	statechart EnergyServerBehavior init GetData {
		on entry print "Energy Server Started!\n"
		state GetData {
			internal
			event e : data_service?sensor_data
			action do
				use_kw = e.use_kw
				print "Processing received aggregated data...\n"
				fa_service!query(use_kw)
			end
			transition -> Ack
			event fa_service?safe
			transition -> Alert
			event fa_service?alert
		}
		state Ack {
			on entry do
				print "✅ Energy usage forecast normal. Acknowledging sensor...\n"
				data_service!ack()
			end
			transition -> GetData
		}
		state Alert {
			on entry do
				print "⚠️ Energy usage spike predicted! Alerting...\n"
				data_service!ack()
			end
			transition -> GetData
		}
	}
}

// EnergyAnalytics: Preprocesses, trains, and forecasts on aggregated use_kw only
thing EnergyAnalytics includes EnergyMsgs {
	provided port fa_service {
		sends alert sends safe receives query
	}
	property use_kw : Float64
	property pred1 : Float64
	property pred2 : Float64
	property pred3 : Float64

	data_analytics da1 @dalib `statsmodel` {
		data {
			dataset "/mnt/data/use_kw_dataset_aggregated.csv"
			labels ON
			features use_kw
			output_features use_kw
			timestamps ON
			common_period_threshold 0
		}
		preprocessing {
			preprocess_feature_scaler MinMaxScaler
			remove_outliers ON
			advanced_imputation ON
			lag_features {
				lag_columns use_kw
				n_lags 3
			}
			rolling_window {
				window_size 3
				columns use_kw
			}
			resample resample_frequency="15min"
			log_transformation target_column="use_kw"
		}
		time_series {
			sequential TRUE
			steps 3
			lag 20
			stationary_check ON
			seasonality_detection ON
		}
		model {
			autoML OFF
			// Prophet Model for single use_kw series
			algorithm Prophet prophet_agg(
				growth "linear",
				seasonality_mode "additive",
				seasonality_prior_scale 10.0,
				holidays_prior_scale 10.0,
				changepoint_prior_scale 0.05,
				interval_width 0.8,

			)

			// XGBoost Model for single use_kw series
			//algorithm XGBoost xgb_agg(
				//max_depth 6,
				//learning_rate 0.1,
				//n_estimators 100,
				//objective "reg:squarederror",
				//booster "gbtree",
				//gamma 0.0,
				//min_child_weight 1.0,
				//subsample 0.8,
				//colsample_bytree 0.8,
				//reg_alpha 0.0,
				//reg_lambda 1.0,
				//scale_pos_weight 1.0,
				//random_state 42,

			//)

			training_results "data/agg_training_results.txt"
		}
		evaluation {
			prediction_results pred1, pred2, pred3
			metrics MSE
		}
		visualization {
			plots LINE_PLOT
		}
	}

	statechart EnergyAnalyticsBehavior init Preprocess {
		on entry print "Energy Analytics Started!\n"
		state Preprocess {
			on entry do
				print "Energy Analytics: Data Preprocessing on aggregated use_kw\n"
				da_preprocess da1
			end
			transition -> Train
		}
		state Train {
			on entry do
				print "Energy Analytics: Training Models on aggregated use_kw\n"
				da_train da1
			end
			transition -> Ready
		}
		state Ready {
			on entry print "Energy Analytics: Ready for Prediction\n"
			transition -> Predict
			event m : fa_service?query
			action do
				use_kw = m.use_kw
			end
		}
		state Predict {
			on entry do
				print "Energy Analytics: Forecasting\n"
				da_predict da1 ( use_kw )
			end
			on exit do
				da_save da1
				print "Forecast Results - Next 3 steps: {pred1}, {pred2}, {pred3}\n"
			end
			transition -> Decide
		}
		state Decide {
			on entry do
				if (pred1 >= 0.8 or pred2 >= 0.8 or pred3 >= 0.8)
					fa_service!alert()
				else
					fa_service!safe()
			end
			transition -> Ready
		}
	}
}

configuration SolarEnergyFlowCfg @compiler `python_java` {
	instance sensorClient : SensorClient
	instance energyServer : EnergyServer
	instance energyAnalytics : EnergyAnalytics
	connector sensorClient.data_service => energyServer.data_service
	connector energyServer.fa_service => energyAnalytics.fa_service
}

