datatype String<256>
	@type_checker `String`
	@c_type `char *`
	@java_type `String`
	@js_type `String`
datatype Boolean<1>
	@type_checker `Boolean`
	@c_type `uint8_t`
	@java_type `boolean`
	@js_type `boolean`
datatype Int32<4>
	@type_checker `Integer`
	@c_type `int32_t`
	@java_type `int`
	@js_type `int`

datatype Float64<8>
	@type_checker `Float64`
	@c_type `double`
	@java_type `double`
	@js_type `number`

thing fragment EnergyMsgs {
	message sensor_data(timestamp : String, use_kw : Float64)
	message ack()
	message query(timestamp : String, use_kw : Float64)
	message alert()
	message safe()
}

thing SensorClient includes EnergyMsgs {
	required port data_service {
		sends sensor_data receives ack
	}
	property my_timestamp : String = "01-01-2020 00:00:00"
	property my_use : Float64 = 0.0

	statechart SensorClientBehavior init SendData {
		on entry print "Sensor Client Started!\n"
		state SendData {
			on entry do
				print "Sending energy usage data...\n"
				data_service!sensor_data(my_timestamp, my_use)
			end
			transition -> ReceiveAck
			event data_service?ack
		}
		state ReceiveAck {
			on entry print "Energy data acknowledged by server.\n"
			transition -> Stop
		}
		state Stop {
			on entry print "Sensor Client Stopped.\n"
		}
	}
}

thing EnergyServer includes EnergyMsgs {
	provided port data_service {
		sends ack receives sensor_data
	}
	required port fa_service {
		sends query receives alert receives safe
	}
	property timestamp : String
	property use_kw : Float64

	statechart EnergyServerBehavior init GetData {
		on entry print "Energy Server Started!\n"
		state GetData {
			internal
			event e : data_service?sensor_data
			action do
				timestamp = e.timestamp
				use_kw = e.use_kw
				print "Processing received energy data...\n"
				fa_service!query(timestamp, use_kw)
			end
			transition -> Ack
			event fa_service?safe
			transition -> Alert
			event fa_service?alert
		}
		state Ack {
			on entry do
				print "✅ Energy usage is within normal range. Acknowledging sensor...\n"
				data_service!ack()
			end
			transition -> GetData
		}
		state Alert {
			on entry do
				print "⚠️ Energy usage spike detected! Alerting...\n"
				data_service!ack()
			end
			transition -> GetData
		}
	}
}

thing EnergyAnalytics includes EnergyMsgs {
	provided port fa_service {
		sends alert sends safe receives query
	}
	property timestamp : String
	property use_kw : Float64
	property pred1 : Float64
	property pred2 : Float64
	property pred3 : Float64

	data_analytics da1 @dalib `statsmodel` {
		data {
			dataset "/home/zahra/test/use_kw_dataset.csv"
			labels ON
			features use_kw
			output_features use_kw
			timestamps ON
			common_period_threshold 0
		}
		preprocessing {
			preprocess_feature_scaler MinMaxScaler
			remove_outliers ON
			advanced_imputation ON
		}
		time_series {
			sequential TRUE
			steps 3
			lag 20
			stationary_check ON
			seasonality_detection ON
		}
		model {
			autoML OFF
			algorithm SARIMA sarima_energy(
				p 1,
				differencing 1,
				q 1,
				seasonalP 1,
				seasonalD 1,
				seasonalQ 1,
				seasonality 24,
				trend "c",
				
			)
			training_results "data/energy_training.txt"
		}
		evaluation {
			prediction_results pred1, pred2, pred3
			metrics MSE
		}
		visualization {
		}
	}

	statechart EnergyAnalyticsBehavior init Preprocess {
		on entry print "Energy Analytics Started!\n"
		state Preprocess {
			on entry do
				print "Energy Analytics: Data Preprocessing\n"
				da_preprocess da1
			end
			transition -> Train
		}
		state Train {
			on entry do
				print "Energy Analytics: Training\n"
				da_train da1
			end
			transition -> Ready
		}
		state Ready {
			on entry print "Energy Analytics: Ready for Prediction\n"
			transition -> Predict
			event m : fa_service?query
			action do
				timestamp = m.timestamp
				use_kw = m.use_kw
			end
		}
		state Predict {
			on entry do
				print "Energy Analytics: Predicting\n"
				da_predict da1 ( use_kw )
			end
			on exit da_save da1
			transition -> Decide
		}
		state Decide {
			on entry do
				if (pred1 >= 1.5 or pred2 >= 1.5 or pred3 >= 1.5)
					fa_service!alert()
				else
					fa_service!safe()
			end
			transition -> Ready
		}
	}
}

configuration EnergyFlowCfg @compiler `python_java` {
	instance sensorClient : SensorClient
	instance energyServer : EnergyServer
	instance energyAnalytics : EnergyAnalytics
	connector sensorClient.data_service => energyServer.data_service
	connector energyServer.fa_service => energyAnalytics.fa_service
}

