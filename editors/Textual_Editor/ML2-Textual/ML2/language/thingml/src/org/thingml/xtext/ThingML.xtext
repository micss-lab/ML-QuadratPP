/**
* Extended by Armin Moin, moin@in.tum.de, moin@arminmoin.de
*/
grammar org.thingml.xtext.ThingML hidden(WS, ML_COMMENT, SL_COMMENT)
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
generate thingML "http://www.thingml.org/xtext/ThingML"


ThingMLModel returns ThingMLModel:
		imports+=Import*
		(types+=Type | protocols+=Protocol | configs+=Configuration)*;	


Import returns Import:
	"import" importURI=STRING ("from" from=ID)?;


PlatformAnnotation returns PlatformAnnotation:
	name=ANNOTATION_ID (value=EXTERN | value=STRING)?; 


NamedElement:
	Protocol | Function  | Message | Port | Configuration | Handler | State | StateContainer | 
	Type | Variable | Instance | AbstractConnector | EnumerationLiteral | Event |
	Parameter | DataAnalytics | //ML2
	";" name=ID // This is never used, it is just to have the attributes in the superclass
;

AnnotatedElement:
	Protocol | Function  | Message | Port | Configuration | Handler | State | StateContainer | 
	Type | PropertyAssign | Variable | Instance | AbstractConnector | EnumerationLiteral |
	Parameter | DataAnalytics | //ML2
	";" ( annotations+=PlatformAnnotation )* // This is never used, it is just to have the attributes in the superclass
;

Variable:
	"var" name=ID ':' typeRef=TypeRef | // This is never used, it is just to have the attributes in the superclass
	LocalVariable | Property | Parameter ;
	
/*****************************************************************************
* TYPES / ENUMERATIONS *
*****************************************************************************/
TypeRef returns TypeRef:
	type=[Type|ID] (^isArray?='[' (cardinality=(IntegerLiteral|PropertyReference))? ']')?
;
Type:
	PrimitiveType | ObjectType | Enumeration | Thing;
PrimitiveType returns PrimitiveType:
	'datatype' name=ID =>'<' ByteSize=INT '>'	( annotations+=PlatformAnnotation )* (';')?;
	
ObjectType returns ObjectType:
	'object' name=ID ( annotations+=PlatformAnnotation )* (';')?;
Enumeration returns Enumeration:
	'enumeration' name=ID (=>'as' typeRef=TypeRef)? ( annotations+=PlatformAnnotation )* '{' (literals+=EnumerationLiteral)* '}';
EnumerationLiteral returns EnumerationLiteral:
	name=ID ('=' init=Literal)? ( annotations+=PlatformAnnotation )* ;
/*****************************************************************************
* THING / COMPONENT MODEL *
*****************************************************************************/
Thing returns Thing:
	'thing' (^fragment?='fragment')? name=ID ('includes' includes+=[Thing|ID] ( "," includes+=[Thing|ID])*)?
	( annotations+=PlatformAnnotation )*'{'
		(messages+=Message | ports += Port | properties+=Property | functions+=Function | assign+=PropertyAssign /* | streams+=Stream*/)*
		(dataAnalytics+=DataAnalytics)* //ML2
		(behaviour=StateMachine)?
	'}';
PropertyAssign returns PropertyAssign:
	'set' property=[Property|ID] (=>'[' index=Expression ']')? '=' init=Expression ( annotations+=PlatformAnnotation )*;
Protocol returns Protocol:
	'protocol' name=ID ( annotations+=PlatformAnnotation )* (';')?;
Function returns Function:
	'function' name=ID '(' (parameters+=Parameter ( "," parameters+=Parameter)* )? ')' (':' typeRef=TypeRef)?
							( annotations+=PlatformAnnotation )* body=Action | AbstractFunction
;
AbstractFunction returns Function:
	abstract?='abstract' 'function' name=ID '(' (parameters+=Parameter ( "," parameters+=Parameter)* )? ')' (':' typeRef=TypeRef)?
							( annotations+=PlatformAnnotation )*
;
Property returns Property:
	(readonly?='readonly')? 'property' name=ID ':' typeRef=TypeRef ( '=' init=Expression)?
	( annotations+=PlatformAnnotation )*
;
Message returns Message:
	'message' name=ID '(' ( parameters+=Parameter ( "," parameters+=Parameter)* )? ')'
	( annotations+=PlatformAnnotation )* (';')?;
	
Parameter returns Parameter:
	name=ID ':' typeRef=TypeRef ( annotations+=PlatformAnnotation )*
;
Port returns Port:
	RequiredPort | ProvidedPort | InternalPort;
	
	
RequiredPort returns RequiredPort:
	(optional?='optional')? 'required' 'port' name=ID ( annotations+=PlatformAnnotation )* '{'
		(('sends' sends+=[Message|ID] ( "," sends+=[Message|ID])* ) |
		('receives' receives+=[Message|ID] ( "," receives+=[Message|ID])* ))*
	'}';
ProvidedPort returns ProvidedPort:
	'provided' 'port' name=ID ( annotations+=PlatformAnnotation )* '{'
		(('sends' sends+=[Message|ID] ( "," sends+=[Message|ID])* ) |
		('receives' receives+=[Message|ID] ( "," receives+=[Message|ID])* ))*
	'}';
InternalPort returns InternalPort:
	'internal' 'port' name=ID ( annotations+=PlatformAnnotation )* '{'
		(('sends' sends+=[Message|ID] ( "," sends+=[Message|ID])* ) |
		('receives' receives+=[Message|ID] ( "," receives+=[Message|ID])* ))*
	'}';
/*****************************************************************************
* STATE MECHINES *
*****************************************************************************/
State returns State:
	StateMachine | FinalState | CompositeState |
	'state' name=ID ( annotations+=PlatformAnnotation )* '{'
		(properties+=Property)*
		(
			('on' 'entry' entry=Action)? &
			('on' 'exit' exit=Action)? &
			(properties+=Property | internal+=InternalTransition | outgoing+=Transition)*
		)
	'}';
Handler:
	Transition | InternalTransition
;
Transition returns Transition:
	'transition' (name=ID)? '->' target=[State|ID]
	( annotations+=PlatformAnnotation )*
	('event' event=Event)?
	('guard' guard=Expression)?
	('action' action=Action)?;
InternalTransition returns InternalTransition:
	{InternalTransition}
	'internal' (name=ID)?
	( annotations+=PlatformAnnotation )*
	('event' event=Event)?
	('guard' guard=Expression)?
	('action' action=Action)?;
CompositeState returns CompositeState:
	'composite' 'state' name=ID 'init' initial=[State|ID] ('keeps' history?='history')?	( annotations+=PlatformAnnotation )* '{'
		(properties+=Property)*
		(
			('on' 'entry' entry=Action)? &
			('on' 'exit' exit=Action)? &
			(properties+=Property | substate+=State | internal+=InternalTransition | outgoing+=Transition)*
		)
		(region+=Region | session+=Session)*
	'}';
StateMachine returns CompositeState: // Actually only another syntax for a composite state
	'statechart' (name=ID)? 'init' initial=[State|ID] ('keeps' history?='history')?	( annotations+=PlatformAnnotation )* '{'
		(properties+=Property)*
		(
			('on' 'entry' entry=Action)? &
			('on' 'exit' exit=Action)? &
			(properties+=Property | substate+=State | internal+=InternalTransition)*
		)
		(region+=Region | session+=Session)*
	'}';
Session returns Session:
	'session' name=ID ('<' maxInstances=(IntegerLiteral | PropertyReference) '>')? 'init' initial=[State|ID] ( annotations+=PlatformAnnotation )* '{'
		(substate+=State)*
	'}';
Region returns Region:
	'region' (name=ID)? 'init' initial=[State|ID] ('keeps' history?='history')?	( annotations+=PlatformAnnotation )* '{'
		(substate+=State)*
	'}';
FinalState returns FinalState:
	'final' 'state' name=ID ( annotations+=PlatformAnnotation )* '{' ('on' 'entry' entry=Action)? '}'
;
StateContainer:
	CompositeState | Region | Session |
	'keeps' initial=[State|ID] ('keeps' history?='history')?	 '{' // This is never used, it is just to have the attributes in the superclass
		(substate+=State)*
	'}'
;
/*****************************************************************************
* DATA ANALYTICS // ML2 Also check out ThingMLScopeProvider at org.thingml.xtext.scoping in thingml and
* 			ThingMLAntlrTokenToAttributeIdMapper at org.thingml.xtext.ui in thingml.ui
*****************************************************************************/


MessageParameter returns MessageParameter:
	Message | Parameter
;




// Grammar for Data Analytics Configurations


DataAnalytics returns DataAnalytics:
    'data_analytics' name=ID (annotations+=PlatformAnnotation)* '{'

        // Data Inputs Section
        'data' '{'
            'dataset' dataset=STRING
            (
                ('labels' labels=Labels)?
                ('features' features+=[Property|ID] ("," features+=[Property|ID])*)?
                ('input_features' input_features+=[Property|ID] ("," input_features+=[Property|ID])*)?
                ('output_features' output_features+=[Property|ID] ("," output_features+=[Property|ID])*)?
                ('timestamps' timestamps=Timestamps)?
                ('common_period_threshold' combine_threshold=INT)?
            )
        '}'

        // Preprocessing Section (optional)
        ('preprocessing' '{'
            
            ('preprocess_feature_scaler' preprocess_feature_scaler=Preprocess_feature_scaler)?
		('preprocess_sample_normalizer' preprocess_sample_normalizer=Preprocess_sample_normalizer)?
            
            ('fill_missing' fill_missing_value=FillingMissingValue)?
            ('remove_outliers' remove_outliers=RemoveOutliers)?
            ('advanced_imputation' advanced_imputation=AdvancedImputation)?
            ('lag_features' lagged_features=LaggedFeatures)?
            ('rolling_window' rolling_window_features=RollingWindowFeatures)?
            ('resample' resampling=Resampling)?
            ('transformations' transformations+=DataTransformation ("," transformations+=DataTransformation)*)?
        '}')?

        // Time Series Specifics and Supervised Learning Settings (optional)
        ('time_series' '{'
            ('sequential' sequential=Sequential)?
            ('steps' steps=IntegerLiteral (',')?)?
            ('lag' lag=IntegerLiteral (',')?)?
            ('multivariate' multivariate=Multivariate)?
            ('stationary_check' stationary=Stationary)?
            ('seasonality_detection' seasonality_detection=SeasonalityDetection)?
            ('supervised_learning' supervised_learning=SupervisedLearning)?
            ('create_lagged_features' create_lagged_features=CreateLaggedFeatures)?
            ('sliding_window' sliding_window=SlidingWindow)?
        '}')?

        // Model Settings Section
        'model' '{'
            ('autoML' autoML=AutoML)?
            ('algorithm' modelAlgorithm=DataAnalyticsModelAlgorithm)?
            
('blackbox_ml' blackbox_ml=BooleanLiteral)?
		('blackbox_ml_model' blackbox_ml_model=STRING)?
		('blackbox_import_algorithm' blackbox_import_algorithm=STRING)?
		('blackbox_label_encoder' blackbox_label_encoder=STRING)?
            ('training_results' trainingResults=STRING)?
            ('hyperparameter_tuning' hyperparameter_tuning=HyperparameterTuning)?
            ('ensemble_methods' ensemble_methods=EnsembleMethods)?
        '}'

        // Evaluation and Analysis Section (optional)
        ('evaluation' '{'
            ('prediction_results' predictionResults+=[Property|ID] ("," predictionResults+=[Property|ID])*)?
            ('metrics' model_evaluation=ModelEvaluation)?
            ('outlier_detection' outlier_detection=OutlierDetection)?
            ('clustering' time_series_clustering=TimeSeriesClustering)?
            ('context' contextArea=ContextArea)?
        '}')?

        // Visualization Section (optional)
        ('visualization' '{'
            ('plots' plots+=PreprocessingPlots ("," plots+=PreprocessingPlots)*)?
        '}')?
    '}';
    
    
    

// Enumerations Definitions

enum Labels:
    NOT_SET='NOT_SET' | OFF='OFF' | ON='ON' | SEMI='SEMI'
;

enum FillingMissingValue:
    NOT_SET='NOT_SET' | OFF='OFF' | ON='ON' | FF='FF' | BF='BF' | INTERPOLATION='INTERPOLATION' | MEAN='MEAN'
;

enum Resampling:
    NOT_SET   = 'NOT_SET'   // default / unset
 
  | MINUTELY  = 'MINUTELY'  // roll up into 1-minute bins
  | HOURLY    = 'HOURLY'    // roll up into 1-hour bins
  | DAILY     = 'DAILY'     // roll up into 1-day bins
  | WEEKLY    = 'WEEKLY'    // roll up into 1-week bins
  | MONTHLY   = 'MONTHLY'   // roll up into 1-month bins
  | YEARLY    = 'YEARLY'    // roll up into 1-year bins
;

enum Multivariate:
    NOT_SET='NOT_SET' | OFF='OFF' | ON='ON'
;

enum Stationary:
    NOT_SET='NOT_SET' | OFF='OFF' | ON='ON'
;

enum SeasonalityDetection:
    NOT_SET='NOT_SET' | OFF='OFF' | ON='ON' | FOURIER='FOURIER' | MOVING_AVERAGE='MOVING_AVERAGE'
;

enum RemoveOutliers:
    NOT_SET='NOT_SET' | OFF='OFF' | ON='ON'
;

enum ContextArea:
    RiverFlow='RiverFlow' | ServerMonitoring='ServerMonitoring' | IoTDataCenter='IoTDataCenter' | Other='Other'
;

enum LaggedFeatures:
    OFF='OFF' | ON='ON'
;

enum RollingWindowFeatures:
    OFF='OFF' | ON='ON'
;

enum AdvancedImputation:
    OFF='OFF' | ON='ON'
;

enum OutlierDetection:
    OFF='OFF' | ON='ON'
;

enum TimeSeriesClustering:
    OFF='OFF' | ON='ON'
;

enum HyperparameterTuning:
    OFF='OFF' | GRID_SEARCH='GRID_SEARCH' | RANDOM_SEARCH='RANDOM_SEARCH' | BAYESIAN_OPTIMIZATION='BAYESIAN_OPTIMIZATION'
;

enum ModelEvaluation:
    RMSE='RMSE' | MAE='MAE' | MSE='MSE' | R_SQUARED='R_SQUARED'
    | ACCURACY='ACCURACY' | PRECISION='PRECISION'
    | RECALL='RECALL' | F1_SCORE='F1_SCORE'
;

enum EnsembleMethods:
    OFF='OFF' | BAGGING='BAGGING' | BOOSTING='BOOSTING' | STACKING='STACKING'
;

enum AutoML:
    NOT_SET='NOT_SET' | OFF='OFF' | ON='ON'
;

enum Sequential:
    NOT_SET='NOT_SET' | FALSE='FALSE' | TRUE='TRUE'
;

enum Timestamps:
    NOT_SET='NOT_SET' | OFF='OFF' | ON='ON'
;

enum Preprocess_feature_scaler:
	NOT_SET='NOT_SET' | OFF='OFF' | STANDARD_SCALER='StandardScaler' | MIN_MAX_SCALER='MinMaxScaler' | ROBUST_SCALER='RobustScaler'  
;

enum Preprocess_sample_normalizer:
	NOT_SET='NOT_SET' | OFF='OFF' | NORMALIZER_L2_NORM='NORMALIZER_L2_NORM' | NORMALIZER_L1_NORM='NORMALIZER_L1_NORM' | NORMALIZER_MAX_NORM='NORMALIZER_MAX_NORM' 
;
enum PreprocessingPlots:
    LINE_PLOT='LINE_PLOT'
    | HISTOGRAM='HISTOGRAM'
    | BOX_PLOT='BOX_PLOT'
    | SCATTER_PLOT='SCATTER_PLOT'
    | HEAT_MAP='HEAT_MAP'
    | AUTOCORRELATION_PLOT='AUTOCORRELATION_PLOT'
    | LAG_PLOT='LAG_PLOT'
    | VIOLIN_PLOT='VIOLIN_PLOT'
    | CORRELATION_MATRIX_PLOT='CORRELATION_MATRIX_PLOT'
    | PAIR_PLOT='PAIR_PLOT'
    | CLASS_IMBALANCE='CLASS_IMBALANCE'
    | MULTIVARIATE_DISTRIBUTION='MULTIVARIATE_DISTRIBUTION'
    
    
    
;

enum PredictionPlots:
    // —— Regression / Forecasting ——
    PREDICTION_VS_ACTUAL        = 'PREDICTION_VS_ACTUAL'        // preds vs. true
  | RESIDUALS_PLOT              = 'RESIDUALS_PLOT'              // residuals vs. index
  | ERROR_DISTRIBUTION          = 'ERROR_DISTRIBUTION'          // hist or KDE of errors
  | CONFIDENCE_INTERVALS        = 'CONFIDENCE_INTERVALS'        // prediction bands
    // —— Classification diagnostics ——
  | CONFUSION_MATRIX            = 'CONFUSION_MATRIX'            // true vs. predicted labels
  | ROC_CURVE                   = 'ROC_CURVE'                   // TPR vs. FPR
  | PR_CURVE                    = 'PR_CURVE'                    // precision vs. recall
;


enum ForecastingPlots:
    FORECAST_VS_ACTUAL='FORECAST_VS_ACTUAL'
    | FORECAST_ERROR='FORECAST_ERROR'
    | FORECAST_INTERVALS='FORECAST_INTERVALS'
;

enum OverfittingPlots:
    TRAINING_LOSS='TRAINING_LOSS'
    | VALIDATION_LOSS='VALIDATION_LOSS'
    | LEARNING_CURVE='LEARNING_CURVE'
    | BIAS_VARIANCE_TRADEOFF='BIAS_VARIANCE_TRADEOFF'
;

enum SupervisedLearning:
    NOT_SET='NOT_SET' | OFF='OFF' | ON='ON'
;

enum CreateLaggedFeatures:
    NOT_SET='NOT_SET' | OFF='OFF' | ON='ON'
;

enum SlidingWindow:
    NOT_SET='NOT_SET' | OFF='OFF' | ON='ON'
;

// Enum for different data transformations that can be applied to your dataset
enum DataTransformation:
    LOG_TRANSFORMATION='LogTransformation'
    | DIFFERENCING='Differencing'
    | NORMALIZATION='Normalization'
    | STANDARDIZATION='Standardization'
    | SCALING='Scaling'
    | SMOOTHING='Smoothing'
    | AGGREGATION='Aggregation'
    | DOWNSAMPLING='Downsampling'
    | UPSAMPLING='Upsampling'
;

// time series models
// TODO To be extended
// ─────────────────────────────────────────────────────────────────────────────
// Top-level union of all model‐algorithm types
// ─────────────────────────────────────────────────────────────────────────────
DataAnalyticsModelAlgorithm returns DataAnalyticsModelAlgorithm:
      ML2_ModelAlgorithm
    | Time_series_ModelAlgorithm
    | PMML_ModelAlgorithm
    | PFA_ModelAlgorithm
;

// ─────────────────────────────────────────────────────────────────────────────
// The ML2 family of algorithms (pure scikit-learn–style, non-TS, non-PMML/PFA)
// ─────────────────────────────────────────────────────────────────────────────
ML2_ModelAlgorithm returns ML2_ModelAlgorithm:
      LinearClassifierLogisticRegression
    | LinearRegression
    | NaiveBayesGaussian
    | NaiveBayesMultinomial
    | NaiveBayesComplement
    | NaiveBayesBernoulli
    | NaiveBayesCategorical
    | DecisionTreeRegressor
    | DecisionTreeClassifier
    | RandomForestRegressor
    | RandomForestClassifier
    | NN_MultilayerPerceptron
    | KMeans
    | MiniBatchKMeans
    | DBSCAN
    | SpectralClustering
    | GaussianMixture
    | SelfTrainingClassifier
    | LabelPropagation
    | LabelSpreading
;

// ─────────────────────────────────────────────────────────────────────────────
// Time-series algorithms, subdivided into TS families
// ─────────────────────────────────────────────────────────────────────────────
Time_series_ModelAlgorithm returns Time_series_ModelAlgorithm:
      Deep_learning_ModelAlgorithm
    | statistical_ModelAlgorithm
    | machine_learning_ModelAlgorithm
    | hybrid_ModelAlgorithm
;

// ─────────────────────────────────────────────────────────────────────────────
// Deep-learning time-series models
// ─────────────────────────────────────────────────────────────────────────────
Deep_learning_ModelAlgorithm returns Deep_learning_ModelAlgorithm:
      MLP
    | GRU
    | CNN
    | LSTM
    | RNN
    | TCN
    | Transformer
;

// ─────────────────────────────────────────────────────────────────────────────
// Classical statistical time-series models
// ─────────────────────────────────────────────────────────────────────────────
statistical_ModelAlgorithm returns statistical_ModelAlgorithm:
      ARIMA
    | SARIMA
    | HWES
    | ETS
    | StateSpaceModel
;

// ─────────────────────────────────────────────────────────────────────────────
// Non-TS machine-learning models often used on windowed/lagged data
// ─────────────────────────────────────────────────────────────────────────────
machine_learning_ModelAlgorithm returns machine_learning_ModelAlgorithm:
      SVR
    | RFR
    | GBM
    | XGBoost
;

// ─────────────────────────────────────────────────────────────────────────────
// Hybrid TS models (e.g. combined ARIMA/GARCH, Facebook Prophet, etc.)
// ─────────────────────────────────────────────────────────────────────────────
hybrid_ModelAlgorithm returns hybrid_ModelAlgorithm:
      ARIMA_GARCH
    | Prophet
;


MLP returns MLP:
  'MLP' name=ID '('
    ('hidden_layer_sizes' hidden_layer_sizes='(' (hidden_layers+=IntegerLiteral ("," hidden_layers+=IntegerLiteral)*) ')' (',')?)?
    ('input_activation' input_activation=Activation (',')?)?
    ('hidden_activation' hidden_activation=Activation (',')?)?
    ('output_activation' output_activation=Activation (',')?)?
    ('regularization' regularization=Regularization (',')?)?
    ('dropout' dropout=FLOAT (',')?)?
    ('optimizer' optimizer=Optimizer (',')?)?
    ('rate' rate=FLOAT (',')?)?
    ('batch_size' batch_size=IntegerLiteral (',')?)?
    ('epochs' epochs=IntegerLiteral (',')?)?
    ('metrics' metrics=Metrics (',')?)?
    ('early_stopping' early_stopping=EarlyStopping (',')?)?
    ('overfitting_Plots' overfitting_Plots=OverfittingPlots (',')?)?
    ('forecasting_plots' forecasting_plots=ForecastingPlots (',')?)?
  ')';

GRU returns GRU:
  'GRU' name=ID '('
    'return_sequences' return_sequences=BooleanLiteral ','
    ('hidden_layer_sizes' hidden_layer_sizes='(' (hidden_layers+=IntegerLiteral ("," hidden_layers+=IntegerLiteral)*) ')' (',')?)?
    ('input_activation' input_activation=Activation (',')?)?
    ('hidden_activation' hidden_activation=Activation (',')?)?
    ('output_activation' output_activation=Activation (',')?)?
    ('regularization' regularization=Regularization (',')?)?
    ('dropout' dropout=FLOAT (',')?)?
    ('optimizer' optimizer=Optimizer (',')?)?
    ('rate' rate=FLOAT(',')?)?
    ('batch_size' batch_size=IntegerLiteral (',')?)?
    ('epochs' epochs=IntegerLiteral (',')?)?
    ('metrics' metrics=Metrics (',')?)?
    ('early_stopping' early_stopping=EarlyStopping (',')?)?
    ('overfitting_Plots' overfitting_Plots=OverfittingPlots (',')?)?
    ('forecasting_plots' forecasting_plots=ForecastingPlots (',')?)?
  ')';

CNN returns CNN:
  'CNN' name=ID '('
    ('units' units=IntegerLiteral (',')?)?
    ('hidden_layer_sizes' hidden_layer_sizes='(' (hidden_layers+=IntegerLiteral ("," hidden_layers+=IntegerLiteral)*) ')' (',')?)?
    ('input_activation' input_activation=Activation (',')?)?
    ('hidden_activation' hidden_activation=Activation (',')?)?
    ('output_activation' output_activation=Activation (',')?)?
    ('regularization' regularization=Regularization (',')?)?
    ('dropout' dropout=FLOAT (',')?)?
    ('optimizer' optimizer=Optimizer (',')?)?
    ('rate' rate=FLOAT (',')?)?
    ('batch_size' batch_size=IntegerLiteral (',')?)?
    ('epochs' epochs=IntegerLiteral (',')?)?
    ('metrics' metrics=Metrics (',')?)?
    ('early_stopping' early_stopping=EarlyStopping (',')?)?
    ('overfitting_Plots' overfitting_Plots=OverfittingPlots (',')?)?
    ('forecasting_plots' forecasting_plots=ForecastingPlots (',')?)?
  ')';

LSTM returns LSTM:
  'LSTM' name=ID '('
    ('units' units=IntegerLiteral (',')?)?
    ('hidden_layer_sizes' hidden_layer_sizes='(' (hidden_layers+=IntegerLiteral ("," hidden_layers+=IntegerLiteral)* )? ')' (',')?)?
    ('return_sequences' return_sequences=BooleanLiteral (',')?)?
    ('input_activation' input_activation=Activation (',')?)?
    ('hidden_activation' hidden_activation=Activation (',')?)?
    ('output_activation' output_activation=Activation (',')?)?
    ('regularization' regularization=Regularization (',')?)?
    ('dropout' dropout=FLOAT (',')?)?
    ('optimizer' optimizer=Optimizer (',')?)?
    ('rate' rate=FLOAT(',')?)?
    ('batch_size' batch_size=IntegerLiteral (',')?)?
    ('epochs' epochs=IntegerLiteral (',')?)?
    ('metrics' metrics=Metrics (',')?)?
    ('early_stopping' early_stopping=EarlyStopping (',')?)?
    ('overfitting_Plots' overfitting_Plots=OverfittingPlots(',')?)?
    ('forecasting_plots' forecasting_plots=ForecastingPlots(',')?)?
  ')';

RNN returns RNN:
  'RNN' name=ID '('
    ('units' units=IntegerLiteral (',')?)?
    ('activation' activation=Activation (',')?)?
    ('return_sequences' return_sequences=BooleanLiteral (',')?)?
    ('regularization' regularization=Regularization (',')?)?
    ('hidden_layer_sizes' hidden_layer_sizes='(' (hidden_layers+=IntegerLiteral ("," hidden_layers+=IntegerLiteral)* )? ')' (',')?)?
    ('optimizer' optimizer=Optimizer (',')?)?
    ('rate' rate=FLOAT(',')?)?
    ('batch_size' batch_size=IntegerLiteral (',')?)?
    ('epochs' epochs=IntegerLiteral (',')?)?
    ('metrics' metrics=Metrics (',')?)?
    ('early_stopping' early_stopping=EarlyStopping (',')?)?
    ('overfitting_Plots' overfitting_Plots=OverfittingPlots(',')?)?
    ('forecasting_plots' forecasting_plots=ForecastingPlots(',')?)?
  ')';

TCN returns TCN:
  'TCN' name=ID '('
    ('hidden_layers' hidden_layers='(' (units+=IntegerLiteral ("," units+=IntegerLiteral)*)? ')' (',')?)?
    ('nb_filters' nb_filters=IntegerLiteral (',')?)?
    ('kernel_size' kernel_size=IntegerLiteral (',')?)?
    ('dilations' dilations=STRING (',')?)?
    ('nb_stacks' nb_stacks=IntegerLiteral (',')?)?
    ('dropout_rate' dropout_rate=FLOAT(',')?)?
    ('activation' activation=Activation (',')?)?
    ('optimizer' optimizer=Optimizer (',')?)?
    ('learning_rate' learning_rate=FLOAT(',')?)?
    ('batch_size' batch_size=IntegerLiteral (',')?)?
    ('epochs' epochs=IntegerLiteral (',')?)?
    ('loss' loss=Loss (',')?)?
    ('metrics' metrics=Metrics (',')?)?
    ('dense_layers' dense_layers='(' (neurons+=IntegerLiteral ("," neurons+=IntegerLiteral)*)? ')' (',')?)?
    ('early_stopping' early_stopping=EarlyStopping (',')?)?
    ('overfitting_Plots' overfitting_Plots=OverfittingPlots(',')?)?
    ('forecasting_plots' forecasting_plots=ForecastingPlots(',')?)?
  ')';

Transformer returns Transformer:
  'Transformer' name=ID '('
    ('hidden_layers' hidden_layers='(' (units+=IntegerLiteral ("," units+=IntegerLiteral)*)? ')' (',')?)?
    ('num_layers' num_layers=IntegerLiteral (',')?)?
    ('d_model' d_model=IntegerLiteral (',')?)?
    ('num_heads' num_heads=IntegerLiteral (',')?)?
    ('dff' dff=IntegerLiteral (',')?)?
    ('dropout_rate' dropout_rate=FLOAT (',')?)?
    ('activation' activation=Activation (',')?)?
    ('optimizer' optimizer=Optimizer (',')?)?
    ('learning_rate' learning_rate=FLOAT (',')?)?
    ('batch_size' batch_size=IntegerLiteral (',')?)?
    ('epochs' epochs=IntegerLiteral (',')?)?
    ('loss' loss=Loss (',')?)?
