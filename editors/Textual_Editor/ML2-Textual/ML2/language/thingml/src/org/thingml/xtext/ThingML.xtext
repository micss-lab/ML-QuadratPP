	('kernel_params' kernel_params=STRING (',')?)?
	('n_jobs' n_jobs=IntegerLiteral (',')?)?
	('verbose' verbose=BooleanLiteral (',')?)?
		('prediction_plots' prediction_plots=PredictionPlots(',')?)?
	
