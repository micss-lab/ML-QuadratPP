SVR returns SVR:
	'SVR' name=ID
	'('
		('kernel' kernel=STRING (',')?)? // Kernel type (e.g., "linear", "poly", "rbf", "sigmoid")
		('degree' degree=IntegerLiteral (',')?)? // Degree of the polynomial kernel function
		('gamma' gamma=STRING (',')?)? // Kernel coefficient
		('coef0' coef0=DOUBLE (',')?)? // Independent term in kernel function
		('tol' tol=DOUBLE (',')?)? // Tolerance for stopping criteria
		('C' C=DOUBLE (',')?)? // Regularization parameter
		('epsilon' epsilon=DOUBLE (',')?)? // Epsilon in the epsilon-SVR model
		('shrinking' shrinking=BooleanLiteral (',')?)? // Whether to use the shrinking heuristic
		('cache_size' cache_size=DOUBLE (',')?)? // Specify the size of the kernel cache
		('verbose' verbose=BooleanLiteral (',')?)? // Enable verbose output
		('max_iter' max_iter=IntegerLiteral (',')?)? // Hard limit on iterations within solver
