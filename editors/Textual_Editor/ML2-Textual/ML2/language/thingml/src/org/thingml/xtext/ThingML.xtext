	')';

RFR returns RFR:
	'RFR' name=ID
	'('
		('n_estimators' n_estimators=IntegerLiteral (',')?)? // The number of trees in the forest
		('criterion' criterion=STRING (',')?)? // The function to measure the quality of a split
		('max_depth' max_depth=IntegerLiteral (',')?)? // The maximum depth of the tree
		('min_samples_split' min_samples_split=IntegerLiteral (',')?)? // The minimum number of samples required to split an internal node
		('min_samples_leaf' min_samples_leaf=IntegerLiteral (',')?)? // The minimum number of samples required to be at a leaf node
		('min_weight_fraction_leaf' min_weight_fraction_leaf=DOUBLE (',')?)? // The minimum weighted fraction of the sum total of weights required to be at a leaf node
		('max_features' max_features=STRING (',')?)? // The number of features to consider when looking for the best split
		('max_leaf_nodes' max_leaf_nodes=IntegerLiteral (',')?)? // Grow trees with `max_leaf_nodes` in best-first fashion
		('min_impurity_decrease' min_impurity_decrease=DOUBLE (',')?)? // A node will be split if this split induces a decrease of the impurity greater than or equal to this value
		('bootstrap' bootstrap=BooleanLiteral (',')?)? // Whether bootstrap samples are used when building trees
		('oob_score' oob_score=BooleanLiteral (',')?)? // Whether to use out-of-bag samples to estimate the generalization accuracy
		('n_jobs' n_jobs=IntegerLiteral (',')?)? // The number of jobs to run in parallel
		('random_state' random_state=IntegerLiteral (',')?)? // Controls both the randomness of the bootstrapping of the samples used when building trees
		('verbose' verbose=BooleanLiteral (',')?)? // Controls the verbosity when fitting and predicting
		('warm_start' warm_start=BooleanLiteral (',')?)? // When set to `True`, reuse the solution of the previous call to fit and add more estimators to the ensemble
		('forecasting_plots' forecasting_plots=ForecastingPlots(',')?)?
		
	')';

GBM returns GBM:
	'GBM' name=ID
	'('
		('loss' loss=STRING (',')?)? // Loss function to be optimized
		('learning_rate' learning_rate=FLOAT (',')?)? // Learning rate shrinks the contribution of each tree by `learning_rate`
		('n_estimators' n_estimators=IntegerLiteral (',')?)? // The number of boosting stages to be run
		('subsample' subsample=DOUBLE (',')?)? // The fraction of samples to be used for fitting the individual base learners
		('criterion' criterion=STRING (',')?)? // The function to measure the quality of a split
		('min_samples_split' min_samples_split=IntegerLiteral (',')?)? // The minimum number of samples required to split an internal node
		('min_samples_leaf' min_samples_leaf=IntegerLiteral (',')?)? // The minimum number of samples required to be at a leaf node
		('min_weight_fraction_leaf' min_weight_fraction_leaf=DOUBLE (',')?)? // The minimum weighted fraction of the sum total of weights required to be at a leaf node
		('max_depth' max_depth=IntegerLiteral (',')?)? // The maximum depth of the tree
		('min_impurity_decrease' min_impurity_decrease=DOUBLE (',')?)? // A node will be split if this split induces a decrease of the impurity greater than or equal to this value
		('init' init=STRING (',')?)? // An estimator object that is used to compute the initial predictions
		('random_state' random_state=IntegerLiteral (',')?)? // Controls the random seed given at each `base_estimator` at each boosting iteration
		('max_features' max_features=STRING (',')?)? // The number of features to consider when looking for the best split
		('alpha' alpha=DOUBLE (',')?)? // The alpha-quantile of the huber loss function and the quantile loss function
		('verbose' verbose=BooleanLiteral (',')?)? // Enable verbose output
		('max_leaf_nodes' max_leaf_nodes=IntegerLiteral (',')?)? // Grow trees with `max_leaf_nodes` in best-first fashion
		('warm_start' warm_start=BooleanLiteral (',')?)? // When set to `True`, reuse the solution of the previous call to fit and add more estimators to the ensemble
		('presort' presort=BooleanLiteral (',')?)? // Whether to presort the data to speed up the finding of best splits
		('forecasting_plots' forecasting_plots=ForecastingPlots(',')?)?
		
	')';

