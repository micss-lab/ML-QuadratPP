// Define Optimizer options
enum Penalty:
	NOT_SET='NOT_SET' | L1="'l1'" | L2="'l2'" | ELASTICNET="'elasticnet'" | NONE="'none'"
;

// Optimizer a.k.a. Solver
enum Optimizer:
	NOT_SET='NOT_SET' | NEWTON_CG='newton-cg' | LBFGS='lbfgs' | LIBLINEAR='liblinear' | SAG='sag' | SAGA='saga' | SGD='sgd' | ADAM='adam' | RMSPROP='RMSprop' | ADADELTA='Adadelta' | ADAGRAD='Adagrad' | ADAMAX='Adamax' | NADAM='Nadam' | FTRL='Ftrl'
;

// Define Rate options for learning rate or decay rate
enum Rate:
    NOT_SET='NOT_SET' | CONSTANT="'constant'" | TIME_BASED="'time_based'" | STEP="'step'" | EXPONENTIAL="'exponential'";



// Define EarlyStopping options for enabling/disabling
enum EarlyStopping:
    NOT_SET='NOT_SET' | ENABLE="'enable'" | DISABLE="'disable'";



enum Regularization:
	NOT_SET='NOT_SET' | L1="'l1'" | L2="'l2'" | L1_L2="'l1_l2'"
;

enum Metrics:
    NOT_SET='NOT_SET' | MSE="'MSE'" | MAE="'MAE'"
    | ACCURACY="'ACCURACY'" | PRECISION="'PRECISION'"
    | RECALL="'RECALL'" | F1_SCORE="'F1_SCORE'";
	
	
	
	
